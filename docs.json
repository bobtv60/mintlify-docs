{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Upview",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "Roblox",
            "pages": [
              "roblox-sdk/introduction",
              "roblox-sdk/analytics",
              "roblox-sdk/heatmaps",
              "roblox-sdk/issues",
              "roblox-sdk/telemetry"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Dashboard",
          "href": "https://upview.gg/dashboard",
          "icon": "layout-dashboard"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@upview.gg"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://upview.gg/dashboard"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/upview",
      "github": "https://github.com/upview",
      "linkedin": "https://linkedin.com/company/upview"
    }
  }
}
